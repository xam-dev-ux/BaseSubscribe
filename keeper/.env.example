# Keeper wallet private key (without 0x prefix)
KEEPER_PRIVATE_KEY=your_private_key_here

# RPC URL for Base
RPC_URL=https://mainnet.base.org

# BaseSubscribe contract address
CONTRACT_ADDRESS=0x...

# Minimum profit threshold in USD
MIN_PROFIT_USD=0.10

# Gas price limit in gwei (optional)
MAX_GAS_PRICE_GWEI=1

# Execution mode: "cron" or "manual"
MODE=cron

# Cron schedule (default: every hour)
CRON_SCHEDULE=0 * * * *
